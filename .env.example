# Copy this file to `.env` for local development.
#
# Most workflows don't need anything here — the justfile derives sensible
# per-worktree defaults from the working directory (server/trunk ports and a
# per-worktree Postgres database inside the shared `hanabi-pg` container).
# Run `just info` to see what the current worktree resolves to.
#
# Set overrides below ONLY if you hit a port collision (rare) or want pinned
# values (e.g. pointing at a Neon database for the server).

# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/hanabi_my_branch
# PORT=18080
# TRUNK_PORT=19080
# WORKTREE_DB=hanabi_my_branch
